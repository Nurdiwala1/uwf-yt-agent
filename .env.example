# Public Supabase project credentials (safe to expose only as NEXT_PUBLIC variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth callback: http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/oauth/callback

# Configure only server-side AI providers. Do not prefix these with NEXT_PUBLIC.
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
VIDEO_PROVIDER=your-video-provider
CRON_SECRET=generate-a-long-random-secret
