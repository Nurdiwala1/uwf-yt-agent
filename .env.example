# Public Supabase project credentials (safe to expose only as NEXT_PUBLIC variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth callback: https://your-vercel-domain/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://your-vercel-domain/api/youtube/oauth/callback

# AI routing. "auto" uses Groq -> OpenRouter -> Ollama and automatically
# falls through when a provider is missing, rate-limited, or unavailable.
AI_PROVIDER=auto

# Primary cloud fallback: Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_RESEARCH_MODEL=groq/compound-mini

# Second fallback: OpenRouter free model router
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
NEXT_PUBLIC_APP_URL=https://your-vercel-domain

# Optional third fallback: Ollama running on a reachable server.
# NOTE: localhost on your own PC is not reachable from Vercel.
OLLAMA_BASE_URL=http://your-ollama-server:11434
OLLAMA_MODEL=llama3.2:3b

# Voice: ElevenLabs dynamically selects any available account voice.
# No fixed voice ID and no male-only restriction are required.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=

# Optional voice backup: Google Cloud Text-to-Speech.
# It has a free monthly quota but requires a Google Cloud API key/billing setup.
GOOGLE_TTS_API_KEY=your-google-tts-api-key
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Neural2-D

VIDEO_PROVIDER=sora-2
CRON_SECRET=generate-a-long-random-secret
