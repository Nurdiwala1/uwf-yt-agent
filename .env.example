# Public Supabase project credentials (safe to expose only as NEXT_PUBLIC variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth callback: https://your-vercel-domain/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://your-vercel-domain/api/youtube/oauth/callback

# Server-side AI provider. Never prefix secrets with NEXT_PUBLIC.
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: if omitted, the worker automatically selects an available male ElevenLabs voice.
ELEVENLABS_VOICE_ID=
VIDEO_PROVIDER=sora-2
CRON_SECRET=generate-a-long-random-secret
