# Public Supabase project credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OAuth callback: https://your-vercel-domain/api/youtube/oauth/callback
YOUTUBE_CLIENT_ID=your-google-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-google-oauth-client-secret
YOUTUBE_REDIRECT_URI=https://your-vercel-domain/api/youtube/oauth/callback

# AI routing. "auto" uses Groq -> OpenRouter -> Ollama and falls through on provider failure.
AI_PROVIDER=auto
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
NEXT_PUBLIC_APP_URL=https://your-vercel-domain
OLLAMA_BASE_URL=http://your-ollama-server:11434
OLLAMA_MODEL=llama3.2:3b

# Video generation. Sora 2 is the primary video provider; Runway is the optional fallback.
OPENAI_API_KEY=your-openai-api-key
VIDEO_PROVIDER=sora-2
RUNWAYML_API_SECRET=your-runway-api-secret

# Voice fallback chain.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Optional secret for a future protected scheduled trigger.
CRON_SECRET=generate-a-long-random-secret
